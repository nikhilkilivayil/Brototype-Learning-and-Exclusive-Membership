# ---------------------------------------------------------------------------
# Brototype Learning Portal — environment configuration
# Copy this file to .env.local and fill in real values.
#
# DEMO MODE: if NEXT_PUBLIC_SUPABASE_URL is missing (or NEXT_PUBLIC_DEMO_MODE
# is "true"), the app runs fully in-memory with seeded demo data — no
# Supabase or Razorpay accounts needed. Great for local preview.
# ---------------------------------------------------------------------------

# Force demo mode even when Supabase vars are present (optional)
NEXT_PUBLIC_DEMO_MODE=true

# --- Supabase (production mode) --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key used by the data layer (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay ---------------------------------------------------------------
# In demo mode payments are simulated and these are not required.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
